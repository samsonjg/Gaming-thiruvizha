# Copy this file to .env.local and fill in real values from your Firebase
# project's web app config (Firebase console → Project settings → General
# → Your apps → Web app → SDK setup and configuration). Never commit
# .env.local — it's already in .gitignore.
#
# These are all client-side (Vite requires the VITE_ prefix to expose a
# var to the browser bundle) and are NOT secrets in the traditional sense —
# Firebase web API keys are safe to ship to the browser by design, because
# actual authorization is enforced by Firestore security rules
# (firestore.rules), not by hiding this config. See docs/SECURITY.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only if you enabled Google Analytics for the Firebase project.
VITE_FIREBASE_MEASUREMENT_ID=
